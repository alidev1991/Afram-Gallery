generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

enum VipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductImageType {
  PRODUCT
  LIFESTYLE
  DETAIL
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  mobile       String   @unique
  email        String?  @unique
  birthDate    DateTime
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  wallet    Wallet?
  vipCode   VipCode?

  @@index([role])
  @@index([createdAt])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  recipientName String
  mobile        String
  province      String
  city          String
  postalAddress String
  postalCode    String
  title         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories Subcategory[]
  products      Product[]

  @@index([isActive, position])
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  slug       String
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, position])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]

  @@index([isActive, position])
}

model Product {
  id               String    @id @default(cuid())
  categoryId       String
  subcategoryId    String?
  name             String
  slug             String    @unique
  description      String?
  shortDescription String?
  longDescription  String?
  model            String?
  sku              String?   @unique
  priceToman       Int
  stock            Int       @default(0)
  isActive         Boolean   @default(true)
  isPublished      Boolean   @default(false)
  isVipOnly        Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory    Subcategory?           @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  collections    ProductCollection[]
  images         ProductImage[]
  orderItems     OrderItem[]
  variants       ProductVariant[]
  options        ProductOption[]
  presentations  ProductPresentation[]
  specifications ProductSpecification[]

  @@index([categoryId, isActive, isPublished])
  @@index([subcategoryId, isActive, isPublished])
  @@index([isVipOnly, isActive, isPublished])
  @@index([createdAt])
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

model ProductImage {
  id             String           @id @default(cuid())
  productId      String
  variantId      String?
  presentationId String?
  url            String?
  storageKey     String?
  imageType      ProductImageType @default(PRODUCT)
  altText        String?
  isPrimary      Boolean          @default(false)
  position       Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([variantId, position])
  @@index([presentationId, position])
  @@index([productId, imageType, isPrimary])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  sku             String?  @unique
  priceToman      Int
  combinationKey  String
  position        Int      @default(0)
  isActive        Boolean  @default(true)
  isPurchasable   Boolean  @default(true)
  inventoryPolicy String?
  stockQuantity   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  images       ProductImage[]
  orderItems   OrderItem[]

  @@unique([productId, combinationKey])
  @@index([productId, isActive, isPurchasable, position])
}

model ProductOption {
  id          String   @id @default(cuid())
  productId   String
  name        String
  slug        String
  displayType String?
  position    Int      @default(0)
  isRequired  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, slug])
  @@index([productId, isActive, position])
}

model ProductOptionValue {
  id          String   @id @default(cuid())
  optionId    String
  label       String
  slug        String
  swatchValue String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  option        ProductOption             @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants      VariantOptionValue[]
  presentations PresentationOptionValue[]

  @@unique([optionId, slug])
  @@index([optionId, isActive, position])
}

model VariantOptionValue {
  variantId     String
  optionValueId String
  createdAt     DateTime @default(now())

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductPresentation {
  id            String   @id @default(cuid())
  productId     String
  slug          String
  title         String?
  position      Int      @default(0)
  isActive      Boolean  @default(true)
  showInListing Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues PresentationOptionValue[]
  images       ProductImage[]

  @@unique([productId, slug])
  @@index([productId, isActive, showInListing, position])
}

model PresentationOptionValue {
  presentationId String
  optionValueId  String
  createdAt      DateTime @default(now())

  presentation ProductPresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  optionValue  ProductOptionValue  @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([presentationId, optionValueId])
  @@index([optionValueId])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  group     String?
  label     String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Order {
  id                    String        @id @default(cuid())
  customerId            String
  status                OrderStatus   @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  paymentReference      String?
  subtotalToman         Int
  discountToman         Int           @default(0)
  shippingCostToman     Int           @default(0)
  walletAmountUsedToman Int           @default(0)
  payableAmountToman    Int
  notes                 String?
  shippingRecipientName String
  shippingMobile        String
  shippingProvince      String
  shippingCity          String
  shippingPostalAddress String
  shippingPostalCode    String
  shippingAddressTitle  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  customer           User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  payments           Payment[]
  invoice            Invoice?
  walletTransactions WalletTransaction[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([deletedAt, createdAt])
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  productId          String?
  variantId          String?
  productName        String
  modelSnapshot      String?
  skuSnapshot        String?
  variantSkuSnapshot String?
  imageUrl           String?
  unitPriceToman     Int
  quantity           Int
  lineTotalToman     Int

  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  optionSnapshots OrderItemOptionSnapshot[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderItemOptionSnapshot {
  id                 String  @id @default(cuid())
  orderItemId        String
  optionName         String
  optionValue        String
  optionSlugSnapshot String?
  valueSlugSnapshot  String?
  position           Int     @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId, position])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  status        PaymentStatus @default(PENDING)
  provider      String?
  transactionId String?
  referenceId   String?
  amountToman   Int
  paidAt        DateTime?
  failedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, transactionId])
  @@index([orderId, status])
  @@index([referenceId])
}

model Invoice {
  id                 String   @id @default(cuid())
  orderId            String   @unique
  invoiceNumber      String   @unique
  invoiceDate        DateTime @default(now())
  paymentMethod      String?
  subtotalToman      Int
  discountToman      Int      @default(0)
  shippingCostToman  Int      @default(0)
  payableAmountToman Int
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String                @id @default(cuid())
  walletId    String
  orderId     String?
  type        WalletTransactionType
  amountToman Int
  description String?
  createdAt   DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([orderId])
}

model VipCode {
  id        String    @id @default(cuid())
  userId    String    @unique
  codeHash  String    @unique
  status    VipStatus @default(PENDING)
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, isActive])
}

model MagazineCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@index([isActive, position])
}

model Article {
  id                 String        @id @default(cuid())
  magazineCategoryId String
  title              String
  slug               String        @unique
  excerpt            String?
  content            String?
  status             ArticleStatus @default(DRAFT)
  coverImageUrl      String?
  coverImageAlt      String?
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  category MagazineCategory @relation(fields: [magazineCategoryId], references: [id], onDelete: Restrict)

  @@index([magazineCategoryId, status, publishedAt])
}
